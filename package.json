{
  "name": "craftly",
  "version": "0.0.0",
  "private": true,
  "description": "Open-source React effects and components library",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "pnpm --filter @craftly/web dev",
    "build": "pnpm --filter @craftly/web build",
    "start": "pnpm --filter @craftly/web start",
    "registry:build": "pnpm --filter @craftly/registry build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,css,json,md,mjs,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,css,json,md,mjs,yaml,yml}\"",
    "verify": "pnpm format:check && pnpm typecheck && pnpm build"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^5.9.3"
  }
}
