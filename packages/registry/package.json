{
  "name": "@craftly/registry",
  "version": "0.0.0",
  "private": true,
  "description": "Source of truth for every Craftly component. Consumed by the docs site and the shadcn registry builder.",
  "type": "module",
  "exports": {
    "./components/*": "./src/components/*/index.tsx",
    "./hooks/*": "./src/hooks/*.ts",
    "./lib/*": "./src/lib/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "gsap": "^3.13.0",
    "three": ">=0.160.0"
  },
  "peerDependenciesMeta": {
    "gsap": {
      "optional": true
    },
    "three": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.3.1"
  }
}
